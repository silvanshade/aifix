# beads / dolt files (added by bd init; agentic-dev gitignore.beads.base)
.dolt/
*.db
.beads/*.jsonl
.beads-credential-key
.beads/hooks/

# rust and build artifacts
target/
dist/
build/
coverage/

# generated dependency stores
node_modules/

# agent worktrees and local analysis caches (agentic-dev H13)
.claude/worktrees/
.codegraph/
.aifix/
.weave/

# user notes
.notes

# bv (beads viewer) local config and caches
.bv/
